      "Read(./.klaudius/base/**)",
      "Edit(./.klaudius/base/**)",
      "Write(./.klaudius/base/**)"
    ]
  },
  "env": {
    "PATH": "/Users/jeffgray/.local/bin:/Users/jeffgray/.npm-global/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH}"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start-worker-guard.mjs"
          }
        ]
      }
    ]
  }
}