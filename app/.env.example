# Klaudius Configuration
# Copy to .env and fill in your own values. Never commit .env to git.

# ============================================================
# AI coding agent
#
# AI_AGENT — which AI coding agent drives this Klaudius install. One of:
#   - "claude-code" (Anthropic Claude Code; the default for pre-codex installs)
#   - "codex"       (OpenAI Codex)
# Set by the init wizard. Read by `klaudius update` (to re-fetch the
# matching template tarball — each agent ships its own scaffold layout)
# and by `klaudius doctor` (to check the right CLI is on PATH). Switching
# after install isn't supported via configure — scaffold a fresh project
# with the other choice instead.
# ============================================================
AI_AGENT=claude-code

# ============================================================
# Operating country and language
#
# OPERATOR_COUNTRY — full country name (e.g. "Italy", "Spain", "France",
#   "the United Kingdom"). Used in natural-language references throughout
#   the skills and as the default region when /find is invoked without
#   an explicit region argument.
# OPERATOR_COUNTRY_CODE — ISO 3166-1 alpha-2 code matching the country
#   (e.g. IT, ES, FR, GB). Passed to the Google Places API so search results,
#   addresses, and ranking favour the right country.
# OPERATOR_LANGUAGE — full language name (e.g. "Italian", "Spanish",
#   "French", "English"). All outreach, follow-ups, and built websites are
#   written in this language.
# OPERATOR_LANGUAGE_CODE — ISO 639-1 code matching the language (e.g. it,
#   es, fr, en). Used by the Places API for response language and as the
#   value of <html lang="..."> on every built site.
#
# Leave any of these blank to fall back to the United Kingdom / English
# defaults (the original Klaudius operating profile).
# ============================================================

OPERATOR_COUNTRY=the United Kingdom
OPERATOR_COUNTRY_CODE=GB
OPERATOR_LANGUAGE=English
OPERATOR_LANGUAGE_CODE=en

# ============================================================
# Pipeline modes
#
# PIPELINE_MODES — comma-separated lead streams the pipeline targets.
#   - "classic"  businesses with NO website (the default)
#   - "rescue"   ALSO target businesses whose existing website is
#     verifiably dead or bad — dead domain, hosting placeholder, broken
#     HTTPS, doesn't work on phones, visibly ancient. /find gates every
#     rescue candidate through scripts/site-check.js; borderline sites
#     don't qualify. Rescue rebuilds of content-rich old sites capture the
#     old site page by page and verify completeness against it, so expect
#     roughly 1.5-2.5x the tokens of a classic build on those leads.
#   - "booking"  ALSO target businesses whose Google-listed "website" is
#     a booking-platform page (Fresha, Booksy, Square, Vagaro...) — they
#     pay for booking software but have no real website. /find gates
#     every candidate through scripts/booking-check.js (the shipped
#     platform registry); their site gets a built-in booking page.
# Unset or blank = classic only. Set by the init/configure wizard
# (lead-streams question); also freely editable here or by asking
# your agent.
# ============================================================

PIPELINE_MODES=classic,rescue,booking

# ============================================================
# Pricing
# PRICING — what you charge SMB clients (any currency string).
# PRICING_TERMS — phrasing slotted next to PRICING in outreach copy.
#   The wizard composes one of three forms based on your upfront/monthly
#   inputs:
#     one-off only:    "one-off, no monthly fees"
#     monthly only:    "per month"
#     setup + monthly: "upfront, then $49/month"
#   Hand-editable to bespoke wording (e.g. "per month, no minimum term"),
#   but a future `klaudius configure` run will recompose it.
# PRICING_MONTHLY — optional. Recurring monthly fee, if any. Stored only
#   for wizard round-trip; the templates never reference it directly.
# All three are referenced as ${PRICING} / ${PRICING_TERMS} throughout
# the operator instructions and the outreach skills.
# ============================================================

PRICING=$999
PRICING_TERMS=one-off, no monthly fees
# PRICING_MONTHLY=

# ============================================================
# Invoicing — ALL OPTIONAL. Used only by the /send-invoice skill.
#
# You never fill these in by hand: the first time you run /send-invoice
# it asks for them in one short conversation and writes them here, and
# every later invoice reuses them. Leave them commented out until then.
# Every value prints on your invoices verbatim — nothing is invented.
#
# INVOICE_BUSINESS_NAME — the name you invoice under (your trading name
#   or registered company name).
# INVOICE_COMPANY_NUMBER — only if you invoice as a registered company:
#   its registration number (Companies House number, KvK, SIREN, ...).
#   Many countries require it on invoices. Sole traders leave it blank.
# INVOICE_BUSINESS_ADDRESS — your business address as it should appear on
#   the invoice. One line; separate address lines with " | " and the
#   invoice renders each segment on its own line.
# INVOICE_TAX_LABEL / INVOICE_TAX_RATE — only if you charge VAT / GST /
#   sales tax: the label as it should print ("VAT", "GST", "MwSt.",
#   "Sales Tax") and the percentage as a bare number (e.g. 20). Leave
#   both blank and invoices carry no tax line at all.
# INVOICE_TAX_ID — your VAT / GST / tax registration number, if you have
#   one (printing it is a legal requirement in most VAT/GST countries
#   once registered).
# INVOICE_PAYMENT_DETAILS — how clients pay you, printed on every
#   invoice. One line; " | " separates rendered lines, e.g.
#   "Bank transfer | Account name: J Smith | Sort code: 00-00-00 | Account no: 12345678"
# INVOICE_NUMBER_PREFIX — invoice numbers print as <PREFIX>-0001,
#   <PREFIX>-0002, ... Defaults to "INV" if unset.
# ============================================================

# INVOICE_BUSINESS_NAME=
# INVOICE_COMPANY_NUMBER=
# INVOICE_BUSINESS_ADDRESS=
# INVOICE_TAX_LABEL=
# INVOICE_TAX_RATE=
# INVOICE_TAX_ID=
# INVOICE_PAYMENT_DETAILS=
# INVOICE_NUMBER_PREFIX=

# ============================================================
# Klaudius automated outreach features
#
# OUTREACH_ENABLED gates the entire outreach pipeline. When false,
# Klaudius will run /find /gather /build /deploy as normal but stop
# short of /outreach — operator pitches manually or not at all. The
# channel config below is only required when OUTREACH_ENABLED=true.
#
# OUTREACH_CHANNELS is the set of channels you've enabled — a
# comma-separated list drawn from: email, whatsapp, sms.
# OUTREACH_PRIORITY is the source of truth for sending: /outreach walks
# it in order per client and picks the first channel that's viable for
# that client AND succeeds (e.g. "email,whatsapp,sms"). Channels you
# didn't enable never appear in it.
#
# SIGNATURE appears at the bottom of every outreach message
# (one line; example: "Thanks, Mike (software developer)").
# ============================================================

OUTREACH_ENABLED=true
OPERATOR_NAME=Your Name
OUTREACH_CHANNELS=email
OUTREACH_PRIORITY=email
SIGNATURE=Thanks, YOUR_NAME (software developer)

# ============================================================
# Email outreach (provider-agnostic, only required if OUTREACH_CHANNELS
# includes "email"). Works with Gmail, Outlook / Microsoft 365, IONOS,
# Fastmail, Zoho, Titan (the white-label mail behind 123 Reg / Hostinger /
# Name.com domains), or any custom IMAP+SMTP host.
# ============================================================

# How Klaudius authenticates to the mailbox:
#   password        (default) app password over SMTP+IMAP — Gmail, Fastmail,
#                   Zoho, IONOS, Titan, custom hosts
#   oauth-microsoft Outlook / Microsoft 365 ONLY. Microsoft permanently
#                   retired app-password access to its mailboxes, so they
#                   connect through a one-time browser sign-in instead:
#                   run `python3 scripts/ms_oauth.py login` after setup.
#                   In this mode EMAIL_PASSWORD and every SMTP/IMAP/folder
#                   setting below are ignored (mail goes via Microsoft's
#                   Graph API), and the sign-in is cached in .ms-token.json.
EMAIL_AUTH=password

EMAIL_ADDRESS=you@yourbusiness.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993

# Display name in the "From" header. Defaults to OPERATOR_NAME from above
# during init; override here if you want the From line to differ from your
# sign-off name (e.g., a business name vs. a personal one).
EMAIL_FROM_NAME=Your Name

# Optional. Set ONLY if you have ever changed EMAIL_ADDRESS: list the
# addresses you previously sent outreach from (comma-separated). Thread
# syncing matches the From line against your addresses to tell your
# messages from the client's — unlisted retired addresses make your own
# old outbound read as client replies forever after a switch.
# EMAIL_ADDRESS_ALIASES=old-address@yourbusiness.com,older@example.com

# Provider-specific folder names (defaults shown; adjust to match your provider)
# Gmail:       sent="[Gmail]/Sent Mail", inbox="INBOX" (or "[Gmail]/All Mail"), drafts="[Gmail]/Drafts"
# Outlook:     sent="Sent Items",         inbox="INBOX",                         drafts="Drafts"
# IONOS UK:    sent="Sent Items",         inbox="INBOX",                         drafts="Drafts"
# Fastmail:    sent="Sent",               inbox="INBOX",                         drafts="Drafts"
# Zoho:        sent="Sent",               inbox="INBOX",                         drafts="Drafts"
# Titan:       sent="Sent",               inbox="INBOX",                         drafts="Drafts"
#   (Titan = the mail behind 123 Reg/Hostinger/Name.com domains. Use your
#   normal mailbox password — no app passwords exist. Webmail Settings must have
#   "Enable Titan on Other Apps" ON and 2FA OFF, or every login is rejected.
#   EU-hosted mailboxes use smtp0101/imap0101.titan.email, not smtp/imap.titan.email.)
EMAIL_SENT_FOLDER=Sent
EMAIL_INBOX_FOLDER=INBOX
# EMAIL_DRAFTS_FOLDER is only read by `gmail.py draft` (manual-approval /
# draft-but-don't-send mode — the message lands in your Drafts for you to review
# and send by hand). Defaults to "Drafts"; Gmail needs "[Gmail]/Drafts".
EMAIL_DRAFTS_FOLDER=Drafts

# OPTIONAL — only needed for the /booking skill's production email mode
# (transactional booking confirmations sent from a converted client's own
# domain, e.g. bookings@theirbusiness.com). Free account at resend.com →
# API Keys → create one with sending access. Leave blank otherwise; demo
# installs send through your mailbox above instead.
RESEND_API_KEY=

# ============================================================
# WhatsApp outreach (only required if OUTREACH_CHANNELS includes
# "whatsapp")
#
# WHATSAPP_ACCOUNTS is a comma-separated list of linked WhatsApp account
# labels (e.g. "primary" or "primary,secondary"). Link each account with
# `npx klaudius pair-whatsapp --label <name>` (scan the QR code from the
# phone that owns that number), then make sure the label is listed here.
# /outreach round-robins sends across the listed accounts and records the
# picked account per client so follow-ups go from the same number. Each
# account's auth state lives in ~/.klaudius/whatsapp/<label>/.
# ============================================================

WHATSAPP_ACCOUNTS=

# ============================================================
# SMS outreach (choose one provider, configure accordingly)
# ============================================================

# Either "imessage" (macOS only, uses Messages.app), "twilio", or "none".
# Avoid switching provider (or rotating the Twilio number) while clients are
# mid-cadence: SMS threads live with whichever number sent them, so the new
# provider can't read or continue the old conversations.
SMS_PROVIDER=none

# Personal mobile that receives test SMS sends from skills (so they don't
# go to a real candidate). Required if SMS_PROVIDER is iMessage or Twilio.
# E.164 format: +<countrycode><number>. Twilio: must differ from
# TWILIO_PHONE_NUMBER below.
TEST_PHONE=

# If SMS_PROVIDER=twilio, fill these in. Otherwise leave blank.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================
# Supabase (required) — this is your CRM.
#
# Klaudius records every business it finds, where each one sits in your
# funnel (gathered → built → deployed → outreach sent → responded →
# won / lost), the follow-up schedule, and the full outreach reply
# history into Supabase. Browse it at any time from the Supabase
# dashboard, or query it conversationally by asking your agent
# ("who replied this week?", "who haven't I followed up with yet?").
#
# Create a project at https://supabase.com (free tier is more than enough).
# ============================================================

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Personal access token used by the Supabase MCP (separate from service key)
# Get one at https://supabase.com/dashboard/account/tokens
SUPABASE_PAT=your-supabase-personal-access-token
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# ============================================================
# Deployment (where the deploy skill ships generated client sites)
#
# DEPLOY_PROVIDER selects the host: "vercel" (default), "cloudflare",
# "netlify", or "selfhost" (your own server over SSH). Set it once; only
# the matching credentials below are read at deploy time. The sites
# Klaudius builds are static Next.js exports, so any of these hosts serve
# them with no adapter — pick whichever you have an account with. To
# switch later, change this line and fill in the other host's credentials
# (or just run `npx klaudius configure`).
#
# ── If DEPLOY_PROVIDER=vercel ──
# VERCEL_TOKEN is a personal API token used by the deploy skill so it can
# run `vercel link / pull / build / deploy` non-interactively. Generate
# one at https://vercel.com/account/tokens (recommended: no expiration).
#
# VERCEL_SCOPE is OPTIONAL. Older single-scope Vercel accounts can leave
# this blank — `vercel link` picks the only scope automatically. Post-2024
# Vercel signups auto-create a team scope (slug like `alice-1234s-projects`)
# rather than using a personal scope, so `vercel link` errors about scope
# without --scope. Set this to your team slug as shown by
# `npx vercel teams ls --token=YOUR_TOKEN`.
#
# ── If DEPLOY_PROVIDER=cloudflare ──
# CLOUDFLARE_API_TOKEN is used by `wrangler pages deploy`. Create it at
# https://dash.cloudflare.com/profile/api-tokens as a Custom Token with
# exactly this permission: Account → Cloudflare Pages → Edit (an
# under-scoped token is the #1 cause of a 403 at deploy time).
# CLOUDFLARE_ACCOUNT_ID is the 32-char hex string from the dashboard URL
# (dash.cloudflare.com/<ACCOUNT_ID>). Required — without it wrangler shows
# an interactive account picker that would stall an unattended run.
#
# ── If DEPLOY_PROVIDER=netlify ──
# NETLIFY_AUTH_TOKEN is a personal access token used by the Netlify CLI so
# the deploy skill can run `netlify sites:create` / `netlify deploy`
# non-interactively. Create one at
# https://app.netlify.com/user/applications#personal-access-tokens
# (recommended: no expiration). A personal access token carries full
# account access, so no separate account ID is needed (unlike Cloudflare).
#
# NETLIFY_ACCOUNT_SLUG is OPTIONAL. Leave it blank if your account has a
# single team — the deploy skill auto-detects it from the token. If you're
# in several Netlify teams, set this to the team slug that should own your
# client sites (Team settings → General → Team details), so new sites land
# in the right team instead of whichever one the API returns first.
#
# ── If DEPLOY_PROVIDER=selfhost ──
# The deploy skill builds each site locally and rsyncs the static export
# to your own server over SSH. Auth is SSH keys only (your key must
# already be authorized on the server — non-standard ports and identity
# files go in ~/.ssh/config, never here).
#
# SELFHOST_DEPLOY_TARGET is the rsync destination base, e.g.
# deploy@203.0.113.7:/var/www/klaudius-sites — each client site uploads
# to <target>/<slug>/.
#
# SELFHOST_URL_TEMPLATE is the public URL pattern with a {slug}
# placeholder, e.g. https://{slug}.sites.example.com. The {slug} must be
# in the HOSTNAME, not the path — static exports use root-absolute asset
# links, so each site has to be served from the root of its own hostname
# (wildcard DNS + a wildcard vhost on your server makes this zero work
# per site).
# ============================================================

DEPLOY_PROVIDER=vercel

VERCEL_TOKEN=your-vercel-api-token
VERCEL_SCOPE=

# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# NETLIFY_AUTH_TOKEN=your-netlify-access-token
# NETLIFY_ACCOUNT_SLUG=

# SELFHOST_DEPLOY_TARGET=deploy@your-server:/var/www/klaudius-sites
# SELFHOST_URL_TEMPLATE=https://{slug}.sites.your-domain.com

# ============================================================
# Google Places API (required for /find skill)
# Get a key at https://console.cloud.google.com/apis (enable "Places API (New)")
# ============================================================

GOOGLE_PLACES_API_KEY=your-google-places-api-key

# PLACES_MAX_PAGES — optional. Result pages fetched per /find search query
# (20 results each; every page is a separately billed API call). 1-3, default 2.
# PLACES_MAX_PAGES=

# ============================================================
# Optional: pipeline notifications
# Used by scripts/notify.sh (notify.ps1 on Windows) for pipeline alerts
# and by scripts/outreach-notify-simple.sh to ping you when outreach
# lands. Skip if you don't want notifications.
#
# NOTIFY_CHANNEL picks how alerts reach you: "telegram" (default),
# "email" (sent to your own inbox via your configured email account),
# or "sms" (sent to your own phone via your configured SMS provider).
#
# NOTIFY_TO is OPTIONAL — where the alert goes for email/sms. Defaults
# to EMAIL_ADDRESS (email) or TEST_PHONE (sms). Ignored for telegram.
#
# TELEGRAM_* are only read when NOTIFY_CHANNEL=telegram. If the channel
# is telegram and these are blank, notifications are simply off.
# ============================================================

NOTIFY_CHANNEL=telegram
# NOTIFY_TO=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# Optional: Higgsfield hero + thin stills (CLI)
# Auth is OAuth: run `higgsfield auth login` once on the builder.
# Workspace: `higgsfield workspace set <id>` (Ultra Private).
# MCP is for Cursor/Claude chat — builds shell the CLI, not MCP.
# HF_HERO=0 skips generative i2v and uses Remotion only.
# Credits ≤500 trigger scripts/notify.sh from render-hero.mjs.
# ============================================================
# HF_HERO=1
# HF_HERO_MODEL=seedance_2_0
# HF_HERO_MODE=std
# HF_HERO_RESOLUTION=720p
# HF_HERO_DURATION=5
# Default is cinematic text→video. Cleared stills are optional:
# HF_HERO_REF=1           # soft --image reference (not a locked start frame)
# HF_HERO_LOCK_STILL=1    # rare: start_image i2v when product fidelity > craft
# Or put a per-client prompt in clients/<slug>/data/hero-prompt.txt
# HF_STILL_MODEL=nano_banana
# HIGGSFIELD_BIN=
